# El navegador usa siempre /api en el mismo origen.
# Vite reenvía /api al backend únicamente en desarrollo.
API_PROXY_TARGET=http://localhost:8080
# Opcional: proveedor de teselas compatible con Leaflet. Vacío = sin solicitudes al proveedor.
# Usar sólo URLs públicas, nunca secretos. Revisar licencia, atribución y límites del proveedor.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
