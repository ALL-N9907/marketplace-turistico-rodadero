# El navegador usa siempre /api en el mismo origen.
# Vite reenvía /api al backend únicamente en desarrollo.
API_PROXY_TARGET=http://localhost:8080
# MapTiler: clave PÚBLICA de navegador restringida por dominio; nunca una credencial privada.
# Vacía = sin solicitudes al proveedor (salvo proveedor alternativo configurado abajo).
VITE_MAPTILER_KEY=
# Opcional: proveedor alternativo compatible con Leaflet; tiene prioridad sobre MapTiler.
# Usar sólo URLs públicas, nunca secretos. Revisar licencia, atribución y límites del proveedor.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
